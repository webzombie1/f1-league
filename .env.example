# F1 League Tracker Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Admin password for the web UI
F1LEAGUE_PASSWORD=your_password_here

# API key for the UDP capture tool to submit results
F1LEAGUE_API_KEY=your_api_key_here

# Timezone (for display purposes)
TIMEZONE=America/Chicago
